{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "sviluppolamiera.it" }],
      "destination": "https://www.sviluppolamiera.it/:path*",
      "statusCode": 301
    },
    {
      "source": "/calculator",
      "destination": "/calcolatore-sviluppo-lamiera",
      "permanent": true
    }
  ]
}
