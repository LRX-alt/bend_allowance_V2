{
  "name": "calcolo-lamiera",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sviluppolamiera/web",
    "build": "npm run build -w @sviluppolamiera/web && node scripts/check-secrets.mjs",
    "preview": "npm run preview -w @sviluppolamiera/web",
    "test": "vitest run",
    "test:rls": "vitest run --config vitest.rls.config.js",
    "lint": "npm run lint -w @sviluppolamiera/web",
    "lint:check": "npm run lint:check -w @sviluppolamiera/web",
    "format": "npm run format -w @sviluppolamiera/web",
    "format:check": "npm run format:check -w @sviluppolamiera/web"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^1.6.1"
  }
}
